# Base URL of the VCF Operations instance (no trailing slash, no /suite-api suffix)
VCFOPS_BASE_URL=https://operations.example.com

VCFOPS_USERNAME=admin
VCFOPS_PASSWORD=changeme

# Auth source name configured in VCF Operations (LOCAL, or an imported LDAP/AD/SSO source)
VCFOPS_AUTH_SOURCE=LOCAL

# Set to false only against instances with self-signed certs you trust (e.g. lab environments)
VCFOPS_VERIFY_SSL=true

# Per-request timeout in seconds
VCFOPS_TIMEOUT=30

# --- MCP server transport/auth (this server, not the VCF Operations API) ---

# "streamable-http" (default, network-reachable) or "stdio" (local subprocess,
# e.g. when launched directly by Claude Desktop/Code)
VCFOPS_MCP_TRANSPORT=streamable-http

VCFOPS_MCP_HOST=127.0.0.1
VCFOPS_MCP_PORT=8000

# Required when VCFOPS_MCP_TRANSPORT=streamable-http. Clients must send
# `Authorization: Bearer <this value>`. Generate one with:
#   openssl rand -hex 32
VCFOPS_MCP_BEARER_TOKEN=
